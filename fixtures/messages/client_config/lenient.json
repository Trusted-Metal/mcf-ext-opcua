{
    "type": "client_config",
    "schema": "1.2",
    "auth_mode": "Certificate",
    "bfs_max_depth": 16,
    "keep_alive_count": 240,
    "lifetime_count": 2400,
    "machine_profile": "Aconity",
    "publish_interval": 250,
    "queue_policy": "DiscardOldest",
    "queue_size_data_change": 50,
    "queue_size_events": 10,
    "reconnect_interval": 1000,
    "root_node": {
        "kind": "BrowseName",
        "value": "MachineFleet"
    },
    "sampling_interval": {
        "kind": "ServerNegotiated"
    },
    "security_mode": "Sign",
    "security_policy": "Basic256Sha256",
    "server_url": "opc.tcp://localhost:4840",
    "session_timeout": 60000,
    "sync_loop_interval_initial": 1000,
    "sync_loop_interval_settled": 30000,
    "extra": {
        "Future_Minor_Attr": {
            "dtype": "u32",
            "value": 9
        }
    }
}